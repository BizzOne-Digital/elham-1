# Database (use MongoDB Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/netbrandit

# Auth — generate a long random string for production (e.g. openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin bootstrap (also stored in MongoDB after seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (production domain, no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Locale / business defaults
HOST_TIME_ZONE=America/Toronto
DEFAULT_CURRENCY=CAD

# Email — Zoho Mail (Canada) for Netbrandit form notifications
SMTP_HOST=smtp.zohocloud.ca
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=info@netbrandit.com
SMTP_PASSWORD=
SMTP_FROM="Netbrandit <info@netbrandit.com>"
# Inbound notifications (contact, leads, bookings)
SMTP_TO=info@netbrandit.com
ADMIN_EMAIL=info@netbrandit.com
