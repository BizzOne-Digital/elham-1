# Database (use MongoDB Atlas URI in production)
MONGODB_URI=mongodb://127.0.0.1:27017/netbrandit

# Auth — generate a long random string for production (e.g. openssl rand -base64 32)
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# Admin bootstrap (also stored in MongoDB after seed)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Public site URL (production domain, no trailing slash)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Locale / business defaults
HOST_TIME_ZONE=America/Toronto
DEFAULT_CURRENCY=CAD

# Email (optional — form notifications)
SMTP_HOST=
SMTP_PORT=
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
